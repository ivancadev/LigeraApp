# Ligera — plantilla de variables de entorno
# Copia este archivo a .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# --- Obligatorias para la app ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Opcionales: IA (solo servidor) ---
# Google AI Studio (Gemini). Nunca la expongas al cliente.
GEMINI_API_KEY=
# Por defecto: gemini-3.1-flash-lite
GEMINI_MODEL=
# Límite diario de peticiones IA por usuario. Por defecto: 20
AI_DAILY_LIMIT=

# --- Opcionales: tooling / MCP (la app no las necesita) ---
# Project ref = prefijo del subdominio de NEXT_PUBLIC_SUPABASE_URL
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
# postgresql://postgres.<project-ref>:<password>@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=
GITHUB_PERSONAL_ACCESS_TOKEN=
