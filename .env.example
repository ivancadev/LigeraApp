# Ligera environment variables
# Copy to .env.local and fill in. Never commit real values.

# --- Required for the app ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional: Supabase MCP server (opencode) ---
# Project ref = subdomain prefix of SUPABASE_URL (e.g. abcdefgh)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Optional: direct Postgres MCP server (opencode) ---
# postgresql://postgres.<project-ref>:<password>@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Optional: GitHub MCP server (opencode) ---
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Optional: AI exercise classification (server-only) ---
# Google AI Studio (Gemini) API key. Never expose it to the client.
GEMINI_API_KEY=
# Defaults to gemini-3.1-flash-lite (free tier) when unset.
GEMINI_MODEL=
# Max AI classification requests per user per day. Defaults to 20.
AI_DAILY_LIMIT=